# ===== KSP Shodhana Frontend Environment Configuration =====
# For standalone local dev (without Docker). Copy to .env.local.

# --- [REQUIRED in production] Backend API URL ---
# In development, falls back to http://localhost:8080 automatically.
# In production (Docker/deployment), this MUST be set.
BACKEND_API_URL=http://localhost:8080

# --- [OPTIONAL] Public-facing Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- [OPTIONAL] Map Center Defaults (Karnataka / Bengaluru Center) ---
NEXT_PUBLIC_MAP_CENTER_LAT=12.9716
NEXT_PUBLIC_MAP_CENTER_LNG=77.5946
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=11

# --- [OPTIONAL] Security & Forensic Watermark Settings ---
NEXT_PUBLIC_ENABLE_FORENSIC_WATERMARK=true
