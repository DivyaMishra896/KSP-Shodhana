# ===== KSP Shodhana Frontend Environment Configuration =====

# Application & API URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Map Center Defaults (Karnataka / Bengaluru Center)
NEXT_PUBLIC_MAP_CENTER_LAT=12.9716
NEXT_PUBLIC_MAP_CENTER_LNG=77.5946
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=11

# Security & Forensic Watermark Settings
NEXT_PUBLIC_ENABLE_FORENSIC_WATERMARK=true
