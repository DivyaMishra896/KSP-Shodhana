# ===== KSP Shodhana Spring Boot Backend Configuration =====
# For standalone local dev (without Docker). Copy to .env.

# --- [REQUIRED] JWT Signing Key ---
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret
JWT_EXPIRATION_MS=28800000

# --- [OPTIONAL] AI Gateway Service URL ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30000

# --- [OPTIONAL] CORS Allowed Origins ---
CORS_ORIGINS=http://localhost:3000

# --- [OPTIONAL] Database Persistence Settings ---
# Default profile uses H2 in-memory (no database setup needed).
# Set to 'prod' and configure Postgres below for full-stack mode.
SPRING_PROFILES_ACTIVE=demo
SPRING_DATASOURCE_URL=jdbc:h2:mem:ksp_shodhana;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_JPA_DIALECT=org.hibernate.dialect.H2Dialect

# --- [OPTIONAL] PostgreSQL (only needed if SPRING_PROFILES_ACTIVE=prod) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ksp_shodhana
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
# SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# --- [OPTIONAL] Neo4j Graph Database ---
# SPRING_NEO4J_URI=bolt://localhost:7687
