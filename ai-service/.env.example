# ===== KSP Shodhana AI Service Configuration =====
# For standalone local dev (without Docker). Copy to .env.

# --- [REQUIRED] Google Gemini API Key ---
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- [OPTIONAL] Gemini Model Specification ---
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MAX_TOKENS=1024

# --- [OPTIONAL] Server Host & Port Configuration ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- [OPTIONAL] CORS Allowed Origins ---
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# --- [OPTIONAL] Backend Orchestrator Service URL (Spring Boot) ---
BACKEND_URL=http://localhost:8080
