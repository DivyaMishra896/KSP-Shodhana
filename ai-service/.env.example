# ===== KSP Shodhana AI Service Configuration =====

# Google Gemini API Key (required for cloud AI extraction)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Specification (specifically tuned for gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# Server Host & Port Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Backend Orchestrator Service URL (Spring Boot)
BACKEND_URL=http://localhost:8080
