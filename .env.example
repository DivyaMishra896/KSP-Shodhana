# ==============================================================
# KSP Shodhana — Root Environment Configuration
# ==============================================================
# Copy this file to .env and fill in required values before
# running `docker-compose up --build`.
#
# Variables marked [REQUIRED] have no safe default — the app
# will refuse to start without them.
# Variables marked [OPTIONAL] have sensible defaults built in.
# ==============================================================

# --- [REQUIRED] Secrets & API Keys ---
# JWT signing key for officer authentication tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret

# Google Gemini API key for AI-powered query understanding.
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- [OPTIONAL] AI Model Configuration ---
GEMINI_MODEL=gemini-flash-lite-latest
JWT_EXPIRATION_MS=28800000

# --- [OPTIONAL] Microservice Port Configuration ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_SERVICE_PORT=8000

# --- [OPTIONAL] Inter-Service Network Bindings ---
# These are the URLs services use to reach each other INSIDE Docker.
# You only need to change these if you customize the service names.
AI_SERVICE_INTERNAL_URL=http://ai-service:8000
BACKEND_INTERNAL_URL=http://backend:8080
BACKEND_API_URL=http://backend:8080

# --- [OPTIONAL] External-facing URLs (for local dev outside Docker) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000

# --- [OPTIONAL] PostgreSQL / PostGIS Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ksp_shodhana
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- [OPTIONAL] Neo4j Graph Database ---
SPRING_NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=none
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- [OPTIONAL] Spring Boot Profile ---
SPRING_PROFILES_ACTIVE=prod

# --- [OPTIONAL] CORS Allowed Origins ---
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
